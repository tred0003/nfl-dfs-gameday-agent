# Copy to nfl-dfs/.env and fill in. Never commit this file.
#
# This is the CLIENT's config -- read by run_report.py, and deliberately NOT
# inside an agent package, because `adk deploy agent_engine` stages every
# variable in the agent's own .env into the deployment.

# Discord webhook for gameday alerts. Anyone holding this can post to your
# server, so treat it as a credential.
DISCORD_WEBHOOK_URL=

# The deployed agent on Agent Platform, from `adk deploy agent_engine`:
#   projects/<number>/locations/<region>/reasoningEngines/<id>
# With this set, run_report.py calls the deployed agent. Leave it blank to run
# the agent in-process instead (same as passing --local).
AGENT_ENGINE_ID=
