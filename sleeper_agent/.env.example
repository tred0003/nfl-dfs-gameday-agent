# Copy to sleeper_agent/.env and fill in. ADK reads .env from INSIDE the agent
# package directory -- not from the repo root, where DISCORD_WEBHOOK_URL lives.

# Route model calls through Agent Platform rather than an AI Studio API key, so
# auth is your gcloud identity and usage lands in GCP.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=advisor-agent-2026
GOOGLE_CLOUD_LOCATION=us-central1

GEMINI_MODEL=gemini-2.5-flash

# The league, from its URL: sleeper.com/leagues/<SLEEPER_LEAGUE_ID>/...
SLEEPER_LEAGUE_ID=

# Which roster in that league is yours. Sleeper's public API needs no key --
# resolve this once from your username:
#   curl https://api.sleeper.app/v1/user/<your_username>
# With it unset, get_my_roster returns an error rather than guessing.
SLEEPER_USER_ID=
