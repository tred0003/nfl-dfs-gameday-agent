# Copy to gameday_agent/.env and fill in. ADK reads .env from INSIDE the agent
# package directory -- not from the repo root, where DISCORD_WEBHOOK_URL lives.

# Route model calls through Agent Platform (the renamed Vertex AI) rather than
# an AI Studio API key, so auth is your gcloud identity and usage lands in GCP.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=advisor-agent-2026
GOOGLE_CLOUD_LOCATION=us-central1

GEMINI_MODEL=gemini-2.5-flash

# Slate context.
SEASON=2026
WEEK=1
# Pin a DraftKings draft group to skip main-slate autodetection. Leave blank in
# season; set it to replay a specific past slate.
DRAFT_GROUP=

# Comma-separated rostered players. With this unset, get_lineup_status returns
# an error rather than an empty lineup that reads as "all clear".
MY_LINEUP=

# Seconds a fetched slate stays usable before the next tool call re-reads it.
SLATE_TTL_SECONDS=90
