# Copy to gameday_agent/.env and fill in. ADK reads .env from INSIDE the agent
# package directory -- not from the repo root, where DISCORD_WEBHOOK_URL lives.

# Route model calls through Agent Platform (the renamed Vertex AI) rather than
# an AI Studio API key, so auth is your gcloud identity and usage lands in GCP.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=advisor-agent-2026
GOOGLE_CLOUD_LOCATION=us-central1

GEMINI_MODEL=gemini-2.5-flash

# Slate context.
SEASON=2026
WEEK=1
# Pin a DraftKings draft group to skip main-slate autodetection. Set it to
# replay a specific past slate; otherwise leave the line COMMENTED OUT.
#
# Do not leave any line here present-but-empty. `adk deploy agent_engine`
# forwards every line of this file as a deployment env var, and Agent Platform
# rejects one with no value:
#   env[5].value: Required field is not set  (400 INVALID_ARGUMENT)
# Blank values are harmless to the local .env reader and fatal to the deploy.
#DRAFT_GROUP=

# Comma-separated rostered players. With this unset, get_lineup_status returns
# an error rather than an empty lineup that reads as "all clear". Fill it in or
# comment it out -- see the warning above about empty values.
#MY_LINEUP=

# Seconds a fetched slate stays usable before the next tool call re-reads it.
SLATE_TTL_SECONDS=90

# Telemetry (2026-10-09). Deploy with --otel_to_cloud to send traces to Cloud
# Trace. That flag defaults content capture to OFF -- timings with no prompts,
# responses or tool results. These two turn content on:
#   spans -> prompt/response/tool args+results on each Cloud Trace span
#   logs  -> the same content as Cloud Logging entries
# Nothing sensitive flows through this agent (public slate data + a lineup).
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=true
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true
