# The deployed agent's settings. Committed on purpose: nothing here is secret,
# and the Cloud Build deploy (deploy/cloudbuild.deploy.yaml) copies this file
# to gameday_agent/.env right before `adk deploy`, which forwards every line
# as a deployment env var. Change a setting HERE, not in a laptop-only .env,
# or the next pipeline deploy quietly puts the old value back.
#
# Every line must have a value -- an empty one is a 400 at deploy.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=advisor-agent-2026
# Where the AGENT lives. Gemini calls go to GEMINI_LOCATION (news.py).
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash
SEASON=2026
SLATE_TTL_SECONDS=90
# Content capture on the --otel_to_cloud traces and logs (2026-10-09).
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=true
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true
