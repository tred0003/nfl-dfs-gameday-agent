# The multi-user web app: sign in, edit your lineup, read your report.
# Cloud Run service `gameday-web`. Only the store and the app go in -- no
# ML model and no gameday agent: the pool comes from the projection job's
# BigQuery table, and src/optimize.py builds the suggested lineups. The one
# Gemini call is the archive Q&A (webapp/ask.py), whose tools live on news-mcp;
# token_cost.py prices it. See deploy/WEB.md and deploy/MCP.md.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

COPY deploy/requirements-web.txt .
RUN pip install --no-cache-dir -r requirements-web.txt

# scoring.py: DK points from box scores, for Ask's weekly exam (webapp/ask_weekly.py),
# which runs as two Cloud Run jobs on this same image -- the exam asks the
# exact Ask code the site serves.
COPY src/user_store.py src/optimize.py src/token_cost.py src/scoring.py ./src/
COPY webapp/ ./webapp/

# One worker, a few threads: four users do not need more, and one process
# means the Firebase app and Firestore client are initialised once.
CMD exec gunicorn --bind :$PORT --workers 1 --threads 8 --timeout 60 --chdir webapp main:app
