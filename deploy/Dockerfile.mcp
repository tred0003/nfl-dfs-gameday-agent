# The news-archive MCP server (mcp_server/server.py): Cloud Run service
# `news-mcp`, next to the table in fantasy-football-ml-503718. See deploy/MCP.md.
#
# Installs the AGENT's requirements plus the MCP SDK, for the same reason as
# Dockerfile.news: the tools are gameday_agent/archive.py, and importing that
# loads the agent package. One archive, not a second copy.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

COPY gameday_agent/requirements.txt .
COPY deploy/requirements-mcp.txt .
RUN pip install --no-cache-dir -r requirements.txt -r requirements-mcp.txt

COPY src/ ./src/
COPY gameday_agent/ ./gameday_agent/
COPY mcp_server/ ./mcp_server/

# Fail the BUILD, not the first call, if an import is missing -- and if the
# tool list is not the three tools the docs promise.
RUN python -c "import asyncio, sys; sys.path.insert(0, '.'); from mcp_server.server import mcp; \
names = sorted(t.name for t in asyncio.run(mcp.list_tools())); print(names); \
assert names == ['player_history', 'search_news_archive', 'search_podcasts'], names"

CMD ["python", "mcp_server/server.py"]
